{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/upload-pdf/(.*)",
      "destination": "/main.py"
    },
    {
      "source": "/upload-pdf/",
      "destination": "/main.py"
    },
    {
      "source": "/ask/(.*)",
      "destination": "/main.py"
    },
    {
      "source": "/ask/",
      "destination": "/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
